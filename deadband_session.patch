+    shadowing_sigma:
+      value:                   # <-- NEEDS A SOURCE.
+      unit: dB
+      source: ""
+
+  spectrum:
+    model: clean               # the control condition: nothing else transmitting
+    background_emitters: []
+
+  gnss:
+    availability: denied       # indoors, no sky view
+
+  wind:
+    model: none
+
+# -----------------------------------------------------------------------------
+# NETWORKS
+# -----------------------------------------------------------------------------
+networks:
+  blue:
+    topology: centralized
+    coordinator: gcs
+    encrypted: true
+    band: 2400                 # MHz
+    qos:
+      reliability: reliable
+      deadline_ms: 100
+
+# -----------------------------------------------------------------------------
+# AGENTS
+# -----------------------------------------------------------------------------
+agents:
+
+  - id: gcs
+    platform: ground_station
+    network: blue
+    colour: "#6B7B85"
+    pose: {x: 0.0, y: -3.4, z: 0.0, yaw: 1.5708}
+    dimensions:
+      length: {value: 0.40, unit: m, source: "Nominal - measure the actual bench"}
