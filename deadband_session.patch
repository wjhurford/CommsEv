+# =============================================================================
+# Deadband scenario — formation keeping (the FIRST hand-written mission rig)
+# =============================================================================
+# The rig for missions/my_first.py. Cars 1 and 2 shuttle in their lanes exactly
+# as in three_car_fleet.yaml. Car 3 does NOT shuttle - it runs your mission,
+# holding station off car 1's flank as car 1 drives back and forth.
+#
+# This is where you watch your own mission drive for the first time. Open it,
+# press Play, watch car 3 sit beside car 1. Then change ONE number in car 3's
+# mission block below and press Play again:
+#
+#   offset: 2.0 -> 3.5     the gap opens
+#   side: left -> right    it swaps flanks
+#   follow: car1 -> car2   it picks a different lead
+#
+# three_car_fleet.yaml stays the untouched benchmark; this is the copy you play
+# with. Everything else - arena, radios, provenance - is identical to it.
+#
+# THE PROVENANCE RULE: every physical quantity is {value, unit, source}.
+# An empty source is allowed but it gets counted and flagged. Never invent one.
+#
+# CONVENTION: pose.z is the BASE of an agent (its ground contact), so an agent
+# occupies [z, z + height]. This matters for lidar: a scan only sees obstacles
+# whose vertical extent crosses the scan plane.
+# =============================================================================
+
+spec_version: 0.1
+name: formation_demo
+description: >
+  Cars 1 and 2 shuttle; car 3 runs missions/my_first.py and keeps station off
+  car 1's flank. The development rig for the first hand-written mission.
+
+# -----------------------------------------------------------------------------
+# ARENA
+# -----------------------------------------------------------------------------
+arena:
+  type: box
+  extent:
+    x: 8.0
+    y: 8.0
+    z: 3.0                     # a room, not a cube - ceiling height
+
+  # What the lidar sees when a beam lands on a wall. The datasheet gives 10 m
+  # against a white Kent sheet and 4 m at 10% diffuse reflectance, so the
+  # surface sets the useful range as much as the sensor does. Brick is matte and
+  # dark: the low figure is the right default here.
+  # NEEDS A MEASUREMENT for the real room - point a car at a wall and record
+  # where returns stop.
+  # Reflectance of the wall surface, 0..1 (or a percentage). Red brick and
+  # concrete sit around 0.25-0.40 in the near infrared - well above the 10%
+  # figure the datasheet uses for its worst case, and well below white paper.
+  # NEEDS A MEASUREMENT: point a car at the wall and record where returns stop.
+  surface_reflectivity: 0.30       # low | medium | high, or a number
+
+  # solid | open | absorbing. 'solid' reflects RF (multipath).
+  boundaries:
+    x_min: solid
+    x_max: solid
+    y_min: solid
+    y_max: solid
+    z_min: solid               # floor
+    z_max: solid               # ceiling
+
+  propagation:
+    model: indoor_multipath
+    path_loss_exponent:
