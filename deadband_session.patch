+    colour: "#2E6FB0"
+    pose: {x: -3.0, y: 2.0, z: 0.0, yaw: 0.0}
+    dimensions:
+      length: {value: 0.55, unit: m, source: "Measured, car #1, 2026-07-21"}
+      width:  {value: 0.30, unit: m, source: "Measured, car #1, 2026-07-21"}
+      height: {value: 0.20, unit: m, source: "Measured, car #1, 2026-07-21"}
+      mass:   {value: , unit: kg, source: ""}            # <-- weigh it
+    performance:
