     # carried from tick to tick and only ever changed by a legal move.
     poses = {a["id"]: {"x": a["start"]["x"], "y": a["start"]["y"],
@@ -918,6 +999,15 @@ def stream(arena, agents, links, duration=None, out=sys.stdout, seed=1):
