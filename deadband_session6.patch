+# =============================================================================
+# Deadband MISSION — squad_patrol
+# =============================================================================
+# Two squads patrolling their own halves of squad_hall, so the hierarchy has
+# something to command. Alpha works the west side (points A-B), bravo the east
+# (C-D). Nothing crosses the middle, which keeps squad-internal links short and
+# cross-squad links long.
+#
+# This is the rig for architecture experiments: run it with the scene's
+# authority/routing as declared, then change them and compare. The interesting
+# ones:
+#   authority: hierarchical + routing: tiered    (as shipped)
+#   authority: centralized  + routing: star      (the brittle baseline)
+#   authority: decentralized + routing: mesh     (the robust baseline)
+#   authority: centralized  + routing: mesh      (the interesting hybrid - the
+#                                                 mesh survives the hub dying,
+#                                                 the decision-making does not)
+# =============================================================================
+
+spec_version: 0.1
+name: squad_patrol
+kind: mission
+
+description: >
+  Two squads shuttling in their own halves of the hall. The tasking rig for
+  architecture experiments - hierarchy needs something to command.
+
+scene: squad_hall
+
+objectives:
+  car1: {do: shuttle, between: [A, B]}
+  car2: {do: shuttle, between: [A, B], offset: 2.0}
+  car3: {do: shuttle, between: [A, B], offset: 4.0}
+  car4: {do: shuttle, between: [C, D]}
+  car5: {do: shuttle, between: [C, D], offset: 2.0}
+  car6: {do: shuttle, between: [C, D], offset: 4.0}
+  # gcs has no objective: a ground station does not drive.
+
+run:
+  duration_s: 180
+  seed: 1
+  realtime_factor: 1.0
+
+logging:
+  rosbag: true
+  metrics: [pdr, latency, link_uptime, position_error]
+  output_dir: runs/
